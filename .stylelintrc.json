{
  "extends": [
    "stylelint-config-standard"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "source",
          "utility",
          "variant",
          "custom-variant",
          "apply",
          "plugin",
          "config",
          "reference",
          "tailwind"
        ]
      }
    ],
    "import-notation": null,
    "no-descending-specificity": null,
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "declaration-no-important": true,
    "length-zero-no-unit": true,
    "color-hex-length": "short",
    "shorthand-property-no-redundant-values": true,
    "comment-empty-line-before": [
      "always",
      {
        "except": [
          "first-nested"
        ],
        "ignore": [
          "after-comment",
          "stylelint-commands"
        ]
      }
    ]
  },
  "ignoreFiles": [
    "dist/**/*.css",
    "node_modules/**"
  ],
  "overrides": [
    {
      "files": [
        "**/*.scss"
      ],
      "customSyntax": "postcss-scss",
      "extends": [
        "stylelint-config-standard-scss"
      ],
      "rules": {
        "at-rule-no-unknown": null,
        "max-nesting-depth": [
          3,
          {
            "ignoreAtRules": [
              "include",
              "media",
              "supports"
            ]
          }
        ],
        "selector-class-pattern": [
          "^(?:(?:l|c|p|u)-[a-z0-9]+(?:-[a-z0-9]+)*(?:__[a-z0-9]+(?:-[a-z0-9]+)*)?(?:--[a-z0-9]+(?:-[a-z0-9]+)*)?|(?:is|has)-[a-z0-9]+(?:-[a-z0-9]+)*)$",
          {
            "message": "Expected a FLOCSS/BEM class: l- c- p- or u- block, optional __element, optional --modifier, or an is-/has- state class (BEM-01)",
            "resolveNestedSelectors": true
          }
        ],
        "media-feature-range-notation": "prefix",
        "at-rule-empty-line-before": [
          "always",
          {
            "except": [
              "first-nested"
            ],
            "ignore": [
              "after-comment",
              "blockless-after-same-name-blockless"
            ]
          }
        ],
        "at-rule-disallowed-list": [
          "extend"
        ]
      }
    }
  ]
}
