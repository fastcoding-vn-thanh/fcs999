  "scripts": {
    "dev": "cross-env NODE_ENV=production BUILD_OUT=./.tmp gulp -f gulpfile.js/index.mjs --cwd . develop",
    "build": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . build",
    "build:fast": "cross-env NODE_ENV=production BUILD_OUT=./.tmp gulp -f gulpfile.js/index.mjs --cwd . buildFast",
    "preview": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . preview",
    "build:js": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . buildJsOnly",
    "lint": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . lint",
    "lint:css": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . lintStylesOnly",
    "lint:html": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . lintHtmlOnly",
    "lint:js": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . lintJsOnly",
    "lint:fix": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . lintFix",
    "lint:fix:html": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . lintHtmlFixOnly",
    "imagemin": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . minifyImage",
    "imagewebp": "cross-env NODE_ENV=production gulp -f gulpfile.js/index.mjs --cwd . convertToWebp"
  },
  "author": "FASTCODING Inc.",
